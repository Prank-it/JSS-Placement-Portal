# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.

# Supabase project URL (found in: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon (public) key — safe to use in the browser.
# Use the ANON key, NOT the service_role key.
# Found in: Project Settings → API → Project API keys
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Logo.dev publishable key for company logos
VITE_LOGO_DEV_PUBLISHABLE_KEY=
